# 抽奖系统后端环境变量模板
#
# 本地开发：复制为 .env 使用（pnpm 会读取）。
# Docker 部署：下载为与 docker-compose.yml 同目录的 .env 即可（curl 命令见 docs/DEPLOY_BACKEND.md）；
#              compose 中所有变量「.env 优先、未设置回退内置默认」，缺项也能启动。

# ---------- 数据库 ----------
# 本地开发直连（DB_HOST 不设置时后端默认 localhost）
DB_PORT=5432
DB_NAME=lottery_system
DB_USER=postgres
DB_PASSWORD=your_password

# DB_HOST 请按场景保持注释（两边各有正确默认）：
#   本地开发：留空 = localhost
#   Docker 部署：留空 = postgres（compose 内置数据库）
#   外部数据库：取消注释并填写实际地址
# DB_HOST=

# Docker 部署专用：postgres 容器初始化凭据（后端连接自动复用，无需重复配置）
# POSTGRES_USER=lottery
# POSTGRES_PASSWORD=change-me-db-password
# POSTGRES_DB=lottery_system
# postgres 对宿主机暴露的端口（默认不暴露，仅内网；compose 里取消 ports 注释后才生效）
# POSTGRES_PORT=5432

# ---------- JWT（必改：openssl rand -hex 32） ----------
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# ---------- 应用 ----------
# 本地开发监听端口
PORT=3000
# Docker 部署：后端对宿主机暴露的端口 / 镜像（固定版本用 sha tag）
# BACKEND_PORT=3000
# BACKEND_IMAGE=ghcr.io/comppsyunion/lottery-tool-service:latest
# 前端域名（CORS），多域名逗号分隔
# CORS_ORIGIN=*

# ---------- 超级管理员引导（可选） ----------
# 三者同时设置且用户表为空时，启动即创建超管；
# 未设置时由首位通过 /auth/register 注册的用户成为超管
# SUPER_ADMIN_USERNAME=admin
# SUPER_ADMIN_PASSWORD=your_super_admin_password
# SUPER_ADMIN_EMAIL=admin@example.com
